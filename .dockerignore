# RAGEve .dockerignore - Exclude files from Docker build context

# Git files
.git
.gitignore
.gitmodules

# CI/CD
.github
.gitlab
.travis.yml
.circleci

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing
.pytest_cache
.coverage
htmlcov/
.tox/
.nox/

# Project-specific excludes
test/
tests/
test_api.db
test_data/
benchmark/
.data

# Documentation
docs/_build
site
*.md
!README.md
!CLAUDE.md

# Frontend build artifacts (if building backend separately)
frontend/
frontend/.next
frontend/out
frontend/node_modules

# Data files (persisted via volumes)
data/
uploads/
chunks/
vectors/
logs/
hf/

# Local config and secrets
.env
.env.local
.env.*.local
.secrets/
credentials.json
*.pem
*.key
*.crt
ssl/

# OS files
tmp/
temp/
*.tmp

# Docker files
docker-compose*.yml
docker-compose.override.yml
Dockerfile*
docker/
!docker/conf/
!docker/service_conf.yaml.template
!docker/entrypoint.sh

# Misc
*.log
*.sqlite
*.db
*.tar
*.gz

# Ollama models (huge, not needed)
.ollama/

# Qdrant data (huge, persisted via volume)
.qdrant/
