# Production Environment Configuration
# Copy to .env and adjust values for your deployment

# ============================================
# Core Database Configuration
# ============================================
MYSQL_HOST=mysql
MYSQL_ROOT_PASSWORD=bazzi-rageve
MYSQL_DBNAME=rag_eve
MYSQL_PORT=3306

# ============================================
# Qdrant Vector Database
# ============================================
QDRANT_URL=http://qdrant:6333
QDRANT_PORT=6333
QDRANT_API_KEY=  # Generate a strong random key for production

# ============================================
# MinIO Object Storage
# ============================================
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=rag_eve
MINIO_PASSWORD=bazzi-rageve

# ============================================
# Redis Cache
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=bazzi-rageve

# ============================================
# Backend Configuration
# ============================================
BACKEND_PORT=8000
GUNICORN_WORKERS=8  # 2 * CPU cores, max 8
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_PORT=3000

# ============================================
# Security (REQUIRED for production)
# ============================================
# For local development, leave empty to disable auth
API_KEY=
JWT_SECRET_KEY=
TRUSTED_PROXY_COUNT=1  # Adjust based on reverse proxy setup

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com,https://app.yourdomain.com

# ============================================
# Storage & Paths
# ============================================
DATA_ROOT=./data

# ============================================
# Logging (use WARNING or ERROR in production)
# ============================================
LOG_LEVEL=WARNING

# ============================================
# Build Metadata (auto-populated in CI/CD)
# ============================================
BUILD_DATE=
VCS_REF=
