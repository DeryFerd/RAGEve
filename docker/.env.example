# ============================================
# RAGEve Docker Environment Configuration
# Used with: docker compose -f docker/docker-compose.yml
# ============================================

# ----------------------------
# MySQL Database (Peewee ORM)
# ----------------------------
# Core variables for MySQL container and backend connection.
# The MySQL container creates a database with this name on first run.
MYSQL_ROOT_PASSWORD=rageve_password
MYSQL_DATABASE=rag_eve
# Backend connects as root (for local development). These mirror the above.
MYSQL_USER=root
MYSQL_PASSWORD=rageve_password
MYSQL_DBNAME=rag_eve

# Legacy SQLAlchemy DB_URL (for backward compatibility during migration)
# Format: mysql+aiomysql://user:password@host:port/database?charset=utf8mb4
# If left empty, falls back to SQLite at DATA_ROOT/chat.db
DB_URL=mysql+aiomysql://root:${MYSQL_ROOT_PASSWORD}@mysql:3306/${MYSQL_DATABASE}?charset=utf8mb4

# ----------------------------
# Vector Database (Qdrant)
# ----------------------------
# Qdrant runs in Docker; no API key needed unless you enable auth on Qdrant.
QDRANT_API_KEY=
# Qdrant server URL (internal Docker network)
QDRANT_URL=http://qdrant:6333
# Vector database provider (currently only qdrant supported)
VECTOR_DB_PROVIDER=qdrant

# ----------------------------
# LLM Inference (Ollama)
# ----------------------------
# Ollama typically runs on the host machine, not in Docker.
# Point to your host's Ollama daemon.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# On Linux, you may need to use: http://172.17.0.1:11434
# Or if ollama runs in Docker, use: http://ollama:11434

# ----------------------------
# Application Settings
# ----------------------------
# CORS origins accepted by the backend (comma-separated, no spaces).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Number of trusted reverse proxies in front of the app (for X-Forwarded-For).
TRUSTED_PROXY_COUNT=1

# API Key: when set, all endpoints require the header "X-API-Key: <value>".
# Leave empty for local development (no auth).
API_KEY=

# Rate limit (requests per minute per IP). Only active when API_KEY is set.
RATE_LIMIT_PER_MINUTE=120

# ----------------------------
# Authentication / JWT
# ----------------------------
# Secret key used to sign JWT cookies. CHANGE THIS in any non-dev deployment.
JWT_SECRET_KEY=change-me-in-production
# JWT lifetime in minutes (default: 24h).
JWT_EXPIRE_MINUTES=1440

# ----------------------------
# Frontend / Email Verification
# ----------------------------
# Public URL of the Next.js frontend (used to build verification links).
FRONTEND_URL=http://localhost:3000

# Email delivery mode: "console" (logs link only) or "smtp" (actually send).
SMTP_DEV_MODE=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=noreply@rageve.local
# SMTP_USE_TLS=true

# ----------------------------
# HuggingFace Integration
# ----------------------------
# Personal access token for downloading private HuggingFace datasets/models.
# Leave empty for anonymous access (public datasets only).
HF_TOKEN=

# ----------------------------
# Storage Paths
# ----------------------------
# Root directory for uploaded files, chunks, and vector index data.
# Inside the container, this maps to /app/data.
DATA_ROOT=/app/data

# Subdirectory names (relative to DATA_ROOT)
UPLOAD_DIR_NAME=uploads
CHUNK_DIR_NAME=chunks
VECTOR_DIR_NAME=vector

# ----------------------------
# Chunking Configuration
# ----------------------------
# Default chunk size in characters
DEFAULT_CHUNK_SIZE=1200
# Overlap between chunks in characters
DEFAULT_CHUNK_OVERLAP=180
# Maximum tokens per chunk (for LLM context management)
DEFAULT_MAX_TOKENS_PER_CHUNK=500

# ----------------------------
# Enhanced PDF Parsing
# ----------------------------
# Enable/disable advanced PDF layout analysis features
ENABLE_COLUMN_DETECTION=true
ENABLE_STRUCTURED_TABLES=true
ENABLE_HIERARCHICAL_CHUNKING=true
ENABLE_READING_ORDER_OPTIMIZATION=true

# ----------------------------
# OCR Configuration
# ----------------------------
# OCR engine: "paddle" (recommended) or "tesseract"
OCR_ENGINE=paddle
# Minimum characters extracted to consider PDF not scanned (skip OCR if above threshold)
OCR_THRESHOLD_CHARS=50

# ----------------------------
# Column Detection Tuning
# ----------------------------
# Number of bins for histogram-based column detection
COLUMN_HISTOGRAM_BINS=50
# Minimum peak height ratio (0-1) for column detection
COLUMN_PEAK_THRESHOLD=0.3
# Minimum gap (points) between columns
COLUMN_MIN_GAP=20.0

# ----------------------------
# PDFPlumber Options
# ----------------------------
# Table extraction strategy: "text", "lines", or "explicit"
PDFPLUMBER_TABLE_STRATEGY=text
# Snap tolerance for pdfplumber (points)
PDFPLUMBER_SNAP_TOLERANCE=3.0
# Join tolerance for pdfplumber (points)
PDFPLUMBER_JOIN_TOLERANCE=3.0

# ----------------------------
# Upload Limits
# ----------------------------
# Maximum file size in bytes (default 500 MB)
MAX_UPLOAD_BYTES=524288000
# Maximum total dataset size in bytes (default 100 GB)
MAX_DATASET_BYTES=107374182400

# ----------------------------
# Logging
# ----------------------------
# Log level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
