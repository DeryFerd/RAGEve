# RAGEve — Unified Environment Configuration
# This file is the single source of truth for all environment variables.
#
# USAGE:
# 1. Edit this file and fill in all REPLACE_* placeholders with real values.
# 2. Copy this file to the project root as .env:
#      cp docker/.env .env
# 3. For the frontend, create frontend/.env.local with:
#      NEXT_PUBLIC_API_KEY=<same-as-API_KEY-below>
#
# DO NOT commit .env or frontend/.env.local to version control.

# ============================================
# Database Connections
# ============================================
# MySQL: Stores users and system configuration
DB_URL_USERS=mysql+aiomysql://root:${MYSQL_ROOT_PASSWORD:-rageve_password}@mysql:3306/rageve?charset=utf8mb4

# OceanBase: Stores chat history, sessions, and messages
DB_URL_CHAT=mysql+aiomysql://root:${OCEANBASE_ROOT_PASSWORD:-oceanbase_password}@oceanbase:3306/rageve?charset=utf8mb4

# ============================================
# JWT Authentication
# ============================================
# Generate a strong secret (64+ random characters):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_SECRET
JWT_EXPIRE_MINUTES=1440  # 24 hours

# ============================================
# SMTP (Email Verification)
# ============================================
# Development: set SMTP_DEV_MODE=console to print emails instead of sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=RAGEve <noreply@rageve.example.com>
SMTP_USE_TLS=true
SMTP_DEV_MODE=console

# ============================================
# API & Security
# ============================================
# Optional global API key (for legacy non-auth clients)
API_KEY=REPLACE_WITH_GENERATED_API_KEY

# CORS Origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Trusted Proxy Count (for X-Forwarded-For)
TRUSTED_PROXY_COUNT=1

# Rate Limiting (requests per minute per IP when API_KEY is set)
RATE_LIMIT_PER_MINUTE=120

# ============================================
# HuggingFace
# ============================================
HF_TOKEN=

# ============================================
# OCR
# ============================================
OCR_ENGINE=paddle
OCR_THRESHOLD_CHARS=50

# ============================================
# Qdrant
# ============================================
QDRANT_API_KEY=

